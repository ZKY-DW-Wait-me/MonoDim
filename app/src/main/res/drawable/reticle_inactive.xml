<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#808080" />
            <size
                android:width="40dp"
                android:height="40dp" />
        </shape>
    </item>
    <!-- 中心点 -->
    <item
        android:left="17dp"
        android:top="17dp"
        android:right="17dp"
        android:bottom="17dp">
        <shape android:shape="oval">
            <solid android:color="#808080" />
        </shape>
    </item>
</layer-list>
